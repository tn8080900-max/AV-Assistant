# Copy this file to .env and add your provider credentials on your own computer.
# Do not commit .env or paste its contents into chat.

# OpenAI-compatible chat completions with tool calling
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini

# ElevenLabs speech-to-text and text-to-speech
ELEVENLABS_API_KEY=replace-with-your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=replace-with-your-elevenlabs-voice-id
ELEVENLABS_STT_MODEL_ID=scribe_v1
ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2

# Optional local file-search folders; separate Windows paths with semicolons.
# Example: C:\Users\YourName\Documents;C:\Users\YourName\Desktop
AV_ALLOWED_DIRECTORIES=

# Only these predefined Windows apps can be launched.
AV_ALLOWED_APPLICATIONS=notepad,calculator

# Set true to enable more detailed local development logs.
AV_DEBUG=false